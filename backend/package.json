{
  "name": "boarding-house-backend",
  "version": "1.0.0",
  "description": "Boarding House Management System - REST API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=src server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "create-admin": "node src/seed/createAdmin.js",
    "test": "node ../scripts/with-java.js firebase emulators:exec --config ../firebase.json --project demo-boardinghouse --only auth,firestore,storage \"node --test --test-concurrency=1 tests/units.test.js tests/workflow.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "expect": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
