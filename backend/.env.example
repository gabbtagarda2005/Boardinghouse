# ====================================================================
# Backend (Node.js + Express) settings. Copy to backend/.env for local use.
# On Render, enter these in the service's Environment tab instead.
# NEVER commit real values. NEVER put these in the web or mobile apps.
# ====================================================================

NODE_ENV=development
# Render sets PORT automatically in production.
PORT=5000

# The admin website allowed to call this API (CORS). Production: your Netlify address.
FRONTEND_URL=http://localhost:5173
# Extra allowed sites, comma-separated (optional).
CORS_ORIGINS=

# ---- Firebase (sign-in + database) ----
# Development: the local Firebase Emulator Suite (npm run emulators). Production: false.
USE_FIREBASE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-boardinghouse
# Production: the service-account JSON (Firebase console → Project settings → Service accounts),
# pasted as one value, or a path to the file for local use. Keep it secret.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=
APP_CHECK_ENFORCE=false

# ---- File storage (photos, payment proofs, receipts) ----
# "supabase" (free plan) or "firebase" (needs the Blaze plan)
FILE_STORAGE=firebase
SUPABASE_URL=
# Supabase SECRET key (sb_secret_… or service_role). Server only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=boardinghouse-files
MAX_UPLOAD_MB=5

# ---- Tenant app download link (production) ----
# e.g. an APK on GitHub Releases, or the Play Store page later.
TENANT_APP_URL=

# ---- Reminders ----
REMINDER_CRON=0 8 * * *
TIMEZONE=Asia/Manila

# ---- Email (optional; not needed to run) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Boarding House <no-reply@example.com>"

# ---- Local emulators only: sample owner for "npm run seed" ----
SEED_ADMIN_EMAIL=admin@boardinghouse.local
SEED_ADMIN_PASSWORD=Admin@12345
