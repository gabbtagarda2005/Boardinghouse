# ====================================================================
# Boarding House backend: SERVER configuration (keep this file private)
# Never copy these values into the admin web app or the mobile app.
# ====================================================================
NODE_ENV=development
PORT=5000
# Browser address of the admin web app (comma-separated if several)
CORS_ORIGINS=http://localhost:5173

# ---- Firebase (Admin SDK) ----
# Development: use the local Firebase Emulator Suite (run "npm run emulators" in the project folder).
USE_FIREBASE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-boardinghouse

# Real Firebase project: set USE_FIREBASE_EMULATORS=false, then fill these in.
#   FIREBASE_PROJECT_ID=your-project-id
#   FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
#   FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json   (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT=

# Require Firebase App Check tokens from the apps (enable after registering App Check).
APP_CHECK_ENFORCE=false

# ---- Uploads ----
MAX_UPLOAD_MB=5

# ---- Automatic reminders (cron, Asia/Manila) ----
REMINDER_CRON=0 8 * * *
TIMEZONE=Asia/Manila

# ---- Email for sending new tenants their login (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Boarding House <no-reply@example.com>"

# ---- Development sample data ----
SEED_ADMIN_EMAIL=admin@boardinghouse.local
SEED_ADMIN_PASSWORD=Admin@12345

# Where uploaded files are kept: firebase (Cloud Storage, needs Blaze) or supabase (private bucket)
FILE_STORAGE=firebase
SUPABASE_URL=
SUPABASE_BUCKET=boardinghouse-files
# Server only. Never put this in the admin web or the app.
SUPABASE_SERVICE_KEY=
