rules_version = '2';

// Boarding House Management System: Cloud Storage Security Rules
// Files are normally uploaded and downloaded through the backend (Admin SDK, which bypasses
// these rules). These rules protect the bucket if anyone accesses it directly.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'ADMIN'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    function under(mb) { return request.resource.size < mb * 1024 * 1024; }

    // Payment proofs: only the tenant who submitted it and the owner can see it.
    match /payment-proofs/{tenantId}/{fileName} {
      allow read: if isAdmin() || isSelf(tenantId);
      allow create: if isSelf(tenantId) && under(5)
        && (isImage() || request.resource.contentType == 'application/pdf');
      allow update, delete: if isAdmin();
    }

    // Room photos: visible to signed-in users, managed by the owner.
    match /room-images/{roomId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && under(5) && isImage();
      allow delete: if isAdmin();
    }

    // Receipts are generated by the backend only.
    match /receipts/{tenantId}/{fileName} {
      allow read: if isAdmin() || isSelf(tenantId);
      allow write: if false;
    }

    // Private tenant documents (IDs, contracts): the tenant and the owner only.
    match /tenant-documents/{tenantId}/{fileName} {
      allow read: if isAdmin() || isSelf(tenantId);
      allow write: if isAdmin() && under(10);
    }

    // Profile photos.
    match /profile-images/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if (isSelf(uid) || isAdmin()) && under(2) && isImage();
    }

    // Everything else is private.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
