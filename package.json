{
  "name": "boarding-house-system",
  "private": true,
  "description": "Boarding House Management System: Firebase project tooling (emulators, security rules, deploy).",
  "scripts": {
    "setup:java": "node scripts/setup-java.js",
    "emulators": "node scripts/with-java.js firebase emulators:start --project demo-boardinghouse --import ./.firebase-data --export-on-exit ./.firebase-data",
    "emulators:fresh": "node scripts/with-java.js firebase emulators:start --project demo-boardinghouse",
    "test:rules": "node scripts/with-java.js firebase emulators:exec --project demo-boardinghouse --only firestore,storage \"node --test firebase/tests/rules.test.js\"",
    "deploy:rules": "firebase deploy --project prod --only firestore:rules,firestore:indexes,storage",
    "use:firebase": "node scripts/use-env.js firebase",
    "use:emulators": "node scripts/use-env.js emulators"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1"
  }
}
