# ====================================================================
# Admin web app: CLIENT configuration (safe to be public)
# These values identify your Firebase project; they are NOT secrets.
# Never put the server's service-account key here.
# ====================================================================

# Backend API (keep "/api/v1" when served from the same domain or via the Vite dev proxy)
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:5000

# Development: sign in against the local Firebase Auth emulator
VITE_USE_FIREBASE_EMULATORS=true

# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-boardinghouse.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-boardinghouse
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Optional Firebase App Check (reCAPTCHA v3 site key). Leave empty to disable.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Public address of this portal's /tenant-app page, used by the login page QR code and
# "Download tenant app" button (e.g. https://portal.example.com/tenant-app).
# Empty: this portal's own /tenant-app (on localhost the QR uses this computer's Wi-Fi address).
VITE_TENANT_APP_URL=
