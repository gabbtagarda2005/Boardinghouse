# ====================================================================
# Admin web app settings (PUBLIC values only: they end up in the browser).
# Local: copy to admin-web/.env.local. Netlify: Site settings → Environment variables.
# Never put server secrets here (no service-account keys, no Supabase secret key).
# ====================================================================

# Backend API.
#   Local development: /api/v1 (Vite forwards it to the backend on this computer)
#   Netlify (production): the full Render address, e.g.
#   VITE_API_URL=https://mcley-boardinghouse-api.onrender.com/api/v1
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:5000

# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# Development with the local emulators: true and the demo values below. Production: false + real values.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-boardinghouse.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-boardinghouse
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Optional Firebase App Check (reCAPTCHA v3 site key). Leave empty to disable.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional: public address of this site's /tenant-app page for the QR code.
# Leave empty on Netlify (the site's own address is used automatically).
VITE_TENANT_APP_URL=
